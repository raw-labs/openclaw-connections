{
  "name": "@raw-labs/openclaw-connections",
  "version": "0.1.0",
  "description": "Native OpenClaw Connections UI and agent tools, using your own Composio project.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "peerDependencies": {
    "openclaw": "2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "1.3.18",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "openclaw": "2026.9.4",
    "typescript": "6.0.3",
    "@types/node": "24.10.13",
    "tsx": "4.23.13",
    "esbuild": "0.27.4",
    "prettier": "3.9.7",
    "jsdom": "26.1.0",
    "@types/jsdom": "21.1.7"
  },
  "scripts": {
    "check": "prettier --check . && tsc --noEmit && pnpm test",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "artifact": "pnpm build && npm pack --pack-destination .local",
    "test:native": "pnpm build && node --import tsx --test tests/native/*.test.ts"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    },
    "controlUi": "./src/control-ui.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raw-labs/openclaw-connections.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
